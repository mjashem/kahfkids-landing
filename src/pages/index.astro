---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Hero from '../components/Hero.astro'
import Trust from '../components/Trust.astro'
import Features from '../components/Features.astro'
import Reviews from '../components/Reviews.astro'
import Pricing from '../components/Pricing.astro'
import FAQ from '../components/FAQ.astro'
import Devices from '../components/Devices.astro'
import SafeScreen from '../components/SafeScreen.astro'
import CTA from '../components/CTA.astro'
import Footer from '../components/Footer.astro'
import FloatingCTA from '../components/FloatingCTA'
import BottomBanner from '../components/BottomBanner'
---

<Layout
  title="Kahf Kids – Safe Learning & Parental Control App for Muslim Kids"
  description="Kahf Kids helps parents manage screen time, block harmful apps and games, access 23K+ curated videos, and provide safe Islamic learning for kids."
>
  <Navbar currentPage="home" />

  <main>
    <Hero />
    <Trust />
    <Features />
    <!-- <Ecosystem /> -->
    <Reviews />
    <Pricing />
    <FAQ />
    <Devices />
    <SafeScreen />
    <CTA />
  </main>

  <Footer />

  <FloatingCTA client:load />
  <BottomBanner client:load />
</Layout>
