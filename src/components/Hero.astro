---
// Hero component props
interface Props {}

import HeroAnimated from './HeroAnimated';
import { getImage } from 'astro:assets';
import featureImg1 from '../assets/hero1.webp';
import featureImg2 from '../assets/hero2.webp';
import featureImg3 from '../assets/hero3.webp';
import featureImg4 from '../assets/hero4.webp';

const {} = Astro.props;

// Pre-optimize slide images
const optimizedSlide1 = await getImage({
  src: featureImg1,
  format: 'webp',
  quality: 100,
  // width: 420,
});

const optimizedSlide2 = await getImage({
  src: featureImg2,
  format: 'webp',
  quality: 100,
  // width: 420,
});

const optimizedSlide3 = await getImage({
  src: featureImg3,
  format: 'webp',
  quality: 100,
  // width: 420,
});

const optimizedSlide4 = await getImage({
  src: featureImg4,
  format: 'webp',
  quality: 100,
  // width: 420,
});

const slides = [
  optimizedSlide1.src,
  optimizedSlide2.src,
  optimizedSlide3.src,
  optimizedSlide4.src
];
---

<HeroAnimated client:load slides={slides} />