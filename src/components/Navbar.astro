---
// Props interface
interface Props {
	currentPage?: string;
}

const { currentPage = "home" } = Astro.props;

// Base URL for public assets
const base = import.meta.env.BASE_URL;
---

<header
	class="sticky top-0 w-full bg-white/95 backdrop-blur-sm z-50 transition-all duration-500 ease-out"
	id="navbar"
	style="box-shadow: 0 2px 8px rgba(0,0,0,var(--shadow-opacity, 0.08));"
>
	<nav class="mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
		<div class="flex items-center justify-between py-4">
			<!-- Logo -->
			<div class="h-[53.18px] w-[78.43px] relative shrink-0">
				<img
					src={`${base}/logo-main.svg`}
					alt="Kahf Kids Logo"
					class="w-full h-full object-contain"
				/>
			</div>

			<!-- Desktop Navigation -->
			<div
				class="hidden md:flex items-center justify-between gap-10"
			>
				<!-- Nav Links -->
				<div
					class="flex items-center gap-[50px] font-normal text-[#222222] text-[16px]"
				>
					<a
						href="#home"
						class="hover:text-[#ff4848] transition-colors">Home</a
					>
					<a
						href="#features"
						class="hover:text-[#ff4848] transition-colors"
						>Features</a
					>
					<a
						href="#pricing"
						class="hover:text-[#ff4848] transition-colors"
						>Pricing</a
					>
					<a
						href="#social-proof"
						class="hover:text-[#ff4848] transition-colors"
						>Reviews</a
					>
					<a
						href="https://kahfkids.com/learn"
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-[#ff4848] transition-colors"
						>Course</a
					>
				</div>

				<!-- Download App Button -->
				<a
					href="#"
					id="download-app-btn-desktop"
					class="download-app-btn bg-[#ff4848] text-white rounded-[10px] h-[50px] px-[24px] flex items-center justify-center hover:bg-[#e63e3e] transition-colors shadow-sm hover:shadow-md"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="font-medium text-[14px]">Download App</span>
				</a>
			</div>

			<!-- Mobile Menu Button -->
			<button
				class="md:hidden p-2 text-gray-900 hover:text-orange-500 transition-colors"
				aria-label="Toggle mobile menu"
				id="mobile-menu-button"
			>
				<svg
					class="w-6 h-6"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</div>

		<!-- Mobile Navigation -->
		<div
			class="hidden md:hidden border-t border-gray-100 pt-4 pb-6"
			id="mobile-menu"
		>
			<div class="flex flex-col items-center space-y-4">
				<a
					href="#home"
					class="text-[#222222] text-[16px] font-normal hover:text-[#ff4848] transition-colors"
				>
					Home
				</a>
				<a
					href="#features"
					class="text-[#222222] text-[16px] font-normal hover:text-[#ff4848] transition-colors"
				>
					Features
				</a>
				<a
					href="#pricing"
					class="text-[#222222] text-[16px] font-normal hover:text-[#ff4848] transition-colors"
				>
					Pricing
				</a>
				<a
					href="#social-proof"
					class="text-[#222222] text-[16px] font-normal hover:text-[#ff4848] transition-colors"
				>
					Reviews
				</a>
				<a
					href="https://kahfkids.com/learn"
					target="_blank"
					rel="noopener noreferrer"
					class="text-[#222222] text-[16px] font-normal hover:text-[#ff4848] transition-colors"
				>
					Course
				</a>

				<!-- Download App Button - Mobile -->
				<a
					href="#"
					id="download-app-btn-mobile"
					class="download-app-btn bg-[#ff4848] text-white rounded-[10px] h-[50px] px-[24px] flex items-center justify-center hover:bg-[#e63e3e] transition-colors shadow-sm w-full max-w-[200px]"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="font-medium text-[14px]">Download App</span>
				</a>
			</div>
		</div>
	</nav>
</header>

<script>
	// OS Detection Function
	function detectOS(): "ios" | "android" | "unknown" {
		const userAgent = navigator.userAgent || navigator.vendor || (window as any).opera;

		// iOS detection (iPhone, iPad, iPod)
		if (/iPad|iPhone|iPod/.test(userAgent) && !(window as any).MSStream) {
			return "ios";
		}

		// Android detection
		if (/android/i.test(userAgent)) {
			return "android";
		}

		return "unknown";
	}

	// App store URLs (update these with actual URLs when available)
	const APP_STORE_URLS = {
		ios: "https://apps.apple.com/us/app/kahf-kids-for-child-parents/id6605937095",
		android: "https://play.google.com/store/apps/details?id=com.kahf.kids&pcampaignid=web_share",
	};

	// Update download button based on detected OS
	function updateDownloadButton() {
		const os = detectOS();
		const desktopBtn = document.getElementById("download-app-btn-desktop") as HTMLAnchorElement | null;
		const mobileBtn = document.getElementById("download-app-btn-mobile") as HTMLAnchorElement | null;

		[desktopBtn, mobileBtn].forEach((btn) => {
			if (!btn) return;

			const span = btn.querySelector("span");
			if (!span) return;

			if (os === "ios") {
				btn.href = APP_STORE_URLS.ios;
				span.textContent = "Download on App Store";
			} else {
				// Android and desktop: link to Play Store
				btn.href = APP_STORE_URLS.android;
				span.textContent = "Get it on Google Play";
			}
		});
	}

	document.addEventListener("DOMContentLoaded", () => {
		// Initialize OS-based download buttons
		updateDownloadButton();

		const mobileMenuButton = document.getElementById("mobile-menu-button");
		const mobileMenu = document.getElementById("mobile-menu");
		const navbar = document.getElementById("navbar");

		// Mobile menu toggle
		if (mobileMenuButton && mobileMenu) {
			mobileMenuButton.addEventListener("click", () => {
				mobileMenu.classList.toggle("hidden");
			});
		}

		// Navbar scroll effect
		if (navbar) {
			const handleScroll = () => {
				const scrollY = window.scrollY;
				// Start fade in at 15px, fully visible by 40px
				const startFade = 15;
				const endFade = 40;

				if (scrollY <= startFade) {
					// No shadow when at top
					navbar.style.setProperty("--shadow-opacity", "0");
				} else if (scrollY >= endFade) {
					// Full shadow when scrolled
					navbar.style.setProperty("--shadow-opacity", "0.08");
				} else {
					// Gradual shadow opacity based on scroll position
					const opacity =
						((scrollY - startFade) / (endFade - startFade)) * 0.08;
					navbar.style.setProperty(
						"--shadow-opacity",
						opacity.toString()
					);
				}
			};

			// Initial check
			handleScroll();

			// Listen for scroll events
			window.addEventListener("scroll", handleScroll);
		}
	});
</script>
