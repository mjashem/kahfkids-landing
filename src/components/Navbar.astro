<script>
	// OS Detection Function
	function detectOS(): "ios" | "android" | "unknown" {
		const userAgent = navigator.userAgent || (window as any).opera;

		// iOS detection (iPhone, iPad, iPod)
		if (/iPad|iPhone|iPod/.test(userAgent) && !(window as any).MSStream) {
			return "ios";
		}

		// Android detection
		if (/android/i.test(userAgent)) {
			return "android";
		}

		return "unknown";
	}

	// App store URLs (update these with actual URLs when available)
	const APP_STORE_URLS = {
		ios: "https://apps.apple.com/us/app/kahf-kids-for-child-parents/id6605937095",
		android: "https://play.google.com/store/apps/details?id=com.kahf.kids&pcampaignid=web_share",
	};

	// Update download button based on detected OS
	function updateDownloadButton() {
		const os = detectOS();
		const desktopBtn = document.getElementById("download-app-btn-desktop") as HTMLAnchorElement | null;
		const mobileBtn = document.getElementById("download-app-btn-mobile") as HTMLAnchorElement | null;

		[desktopBtn, mobileBtn].forEach((btn) => {
			if (!btn) return;

			const span = btn.querySelector("span");
			if (!span) return;

			if (os === "ios") {
				btn.href = APP_STORE_URLS.ios;
				span.textContent = "Start Your Free Trail";
			} else {
				// Android and desktop: link to Play Store
				btn.href = APP_STORE_URLS.android;
				span.textContent = "Start Your Free Trail";
			}
		});
	}

	document.addEventListener("DOMContentLoaded", () => {
		// Initialize OS-based download buttons
		updateDownloadButton();

		const mobileMenuButton = document.getElementById("mobile-menu-button");
		const mobileMenu = document.getElementById("mobile-menu");
		const navbar = document.getElementById("navbar");

		// Mobile menu toggle
		if (mobileMenuButton && mobileMenu) {
			mobileMenuButton.addEventListener("click", () => {
				mobileMenu.classList.toggle("hidden");
			});
		}

		// Navbar scroll effect with hide/show on scroll direction
		if (navbar) {
			let lastScrollY = window.scrollY;
			let ticking = false;

			const handleScroll = () => {
				const scrollY = window.scrollY;

				// Shadow opacity effect
				const startFade = 15;
				const endFade = 40;

				if (scrollY <= startFade) {
					navbar.style.setProperty("--shadow-opacity", "0");
				} else if (scrollY >= endFade) {
					navbar.style.setProperty("--shadow-opacity", "0.08");
				} else {
					const opacity = ((scrollY - startFade) / (endFade - startFade)) * 0.08;
					navbar.style.setProperty("--shadow-opacity", opacity.toString());
				}

				// Hide/show navbar based on scroll direction
				if (scrollY > lastScrollY && scrollY > 100) {
					// Scrolling down & past 100px - hide navbar
					navbar.style.transform = "translateY(-100%)";
				} else if (scrollY < lastScrollY || scrollY <= 100) {
					// Scrolling up or near top - show navbar
					navbar.style.transform = "translateY(0)";
				}

				lastScrollY = scrollY;
				ticking = false;
			};

			const requestTick = () => {
				if (!ticking) {
					window.requestAnimationFrame(handleScroll);
					ticking = true;
				}
			};

			// Initial check
			handleScroll();

			// Listen for scroll events with RAF optimization
			window.addEventListener("scroll", requestTick, { passive: true });
		}
	});
</script>
