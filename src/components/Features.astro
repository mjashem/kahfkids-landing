---
import FeaturesAnimated from './FeaturesAnimated.tsx';
import { getImage } from 'astro:assets';

// Import all feature images
import featureImage1 from '../assets/feature1.png';
import featureImage2 from '../assets/feature2.png';
import featureImage3 from '../assets/feature3.png';
import featureImage4 from '../assets/feature4.png';
import featureImage5 from '../assets/feature5.png';
import featureImage6 from '../assets/feature6.png';
import featureImage7 from '../assets/feature7.png';
import featureImage8 from '../assets/feature8.png';
import featureImage9 from '../assets/feature9.png';
import featureImage10 from '../assets/feature10.png';


// Optimize all images to WebP
const imageMap = {
  'feature-image-1': (await getImage({ src: featureImage1, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-2': (await getImage({ src: featureImage2, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-3': (await getImage({ src: featureImage3, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-4': (await getImage({ src: featureImage4, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-5': (await getImage({ src: featureImage5, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-6': (await getImage({ src: featureImage6, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-7': (await getImage({ src: featureImage7, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-8': (await getImage({ src: featureImage8, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-9': (await getImage({ src: featureImage9, format: 'webp', quality: 100, width: 450, height: 300 })).src,
  'feature-image-10': (await getImage({ src: featureImage10, format: 'webp', quality: 100, width: 450, height: 300 })).src,
};
---

<FeaturesAnimated client:visible optimizedImages={imageMap} />